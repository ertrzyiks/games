      },
      "price": 15,
      "description": {
        "en": "Restores 35 HP to one party member. Usable both in and out of battle. Sold by each world's merchant for 15 credits.",
        "pl": "Przywraca 35 PŻ jednemu członkowi drużyny. Można użyć w walce i poza nią. Kupiec na każdym świecie sprzedaje ją za 15 kredytów."
      }
    },
    {
      "id": "tonic",
      "name": {
        "en": "Attack Elixir",
        "pl": "Eliksir Ataku"
      },
      "price": 20,
      "description": {
        "en": "Raises one party member's Attack by 9 for 3 turns. Used in battle, the buff applies immediately; used outside battle, it's queued onto that member and applies the moment the party's next fight begins. Sold by each world's merchant for 20 credits.",
        "pl": "Zwiększa Atak jednego członka drużyny o 9 na 3 tury. Użyty w walce działa od razu; użyty poza walką zostaje przypisany temu bohaterowi i zadziała na początku następnej walki drużyny. Kupiec na każdym świecie sprzedaje go za 20 kredytów."
      }
    },
    {
      "id": "resistTonic",
      "name": {
        "en": "Resistance Elixir",
        "pl": "Eliksir Odporności"
      },
      "price": 20,
      "description": {
        "en": "Raises one party member's Defense by 4 for 3 turns, reducing the damage they take. Used in battle, the buff applies immediately; used outside battle, it's queued onto that member and applies the moment the party's next fight begins. Sold by each world's merchant for 20 credits.",
        "pl": "Zwiększa Obronę jednego członka drużyny o 4 na 3 tury, zmniejszając otrzymywane obrażenia. Użyty w walce działa od razu; użyty poza walką zostaje przypisany temu bohaterowi i zadziała na początku następnej walki drużyny. Kupiec na każdym świecie sprzedaje go za 20 kredytów."
      }
    }
